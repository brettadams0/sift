<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      §3 — the complete permission list.

      There is deliberately no INTERNET permission. Sift is 100% on-device:
      no accounts, no network, no cost (§0). Google Photos has no delete API
      for content it did not create, so there is nothing useful the network
      could do here anyway, and its absence is the strongest possible
      statement that the camera roll never leaves the device.

      ACCESS_MEDIA_LOCATION is not optional: without it MediaStore silently
      strips GPS from every frame it hands over, and the loss is invisible
      for months (trap #12).

      There is no write permission either — scoped storage covers MediaStore
      inserts into Pictures/Sift (§6.11).
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- READ_MEDIA_IMAGES is API 33+. Android 11 and 12 are inside minSdk 30
         and need the older permission, capped so it is not requested above 32. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      WorkManager pulls ACCESS_NETWORK_STATE in through manifest merging so it
      can evaluate NetworkType constraints. Sift never sets one — grading is
      gated on battery and charging only (§9.2) — and an app whose entire pitch
      is that nothing leaves the device should not list a network permission on
      its settings page. Removed explicitly; the `verifyNoNetworkPermissions`
      task in app/build.gradle.kts fails the build if it ever comes back.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      Two others arrive from WorkManager and are kept deliberately: WAKE_LOCK
      holds the CPU during the foreground grading service (§9.2), and
      RECEIVE_BOOT_COMPLETED lets a batch deferred until charging survive a
      reboot instead of being silently dropped.
    -->

    <application
        android:name=".SiftApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sift">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Sift">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          §9.2 — grading runs in a foreground service with progress, and is
          cancellable and resumable. WorkManager's own foreground support is
          used rather than a bespoke Service so that process death resumes
          from Room state (§4.2).
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Hilt supplies the WorkerFactory, so the default initializer is removed. -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
